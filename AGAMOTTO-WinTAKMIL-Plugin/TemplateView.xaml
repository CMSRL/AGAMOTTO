<UserControl x:Class="AGAMOTTO_WinTAK_Plugin.TemplateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:AGAMOTTO_WinTAK_Plugin"
             d:DataContext="{d:DesignInstance Type=local:TemplateDockPane}"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="860"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType">

    <!-- Color Palette & Styles -->
    <UserControl.Resources>
        <SolidColorBrush x:Key="Bg"            Color="#1E1E1E"/>
        <SolidColorBrush x:Key="Card"          Color="#242424"/>
        <SolidColorBrush x:Key="CardBorder"    Color="#494949"/>
        <SolidColorBrush x:Key="TextPrimary"   Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#B8B8B8"/>
        <SolidColorBrush x:Key="Accent"        Color="#3FA7FF"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <Style x:Key="LabelText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Height" Value="30"/>
        </Style>

        <DataTemplate x:Key="LogLineTemplate">
            <TextBlock Text="{Binding}"
                       FontFamily="Consolas"
                       Foreground="{StaticResource TextPrimary}"/>
        </DataTemplate>

        <Style x:Key="DarkRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <!-- outer ring -->
                                <Ellipse Stroke="{StaticResource CardBorder}" StrokeThickness="1" Fill="#2B2B2B"/>
                                <!-- inner dot -->
                                <Ellipse x:Name="Dot" Width="10" Height="10" Fill="{StaticResource Accent}" Visibility="Hidden"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
    </UserControl.Resources>

    <!-- Layout -->
    <Grid Background="#1E1E1E" Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180*"/>
            <ColumnDefinition Width="29*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Connection -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="Connection" Style="{StaticResource SectionHeader}" FontSize="14"/>
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" HorizontalAlignment="Left" Margin="0,0,8,0">
                        <TextBlock Text="IP" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="0,0,16,0" ToolTip="127.0.0.1"/>

                        <TextBlock Text="Port" Style="{StaticResource LabelText}"/>
                        <TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="90" Margin="0,0,16,0" ToolTip="65432"/>

                        <Button Content="Test Connection" Command="{Binding TestConnectionCommand}"
                                Style="{StaticResource GhostButton}" Width="140" Margin="0,0,8,0"/>
                        
                        <Button Content="Send Map Data to Listener" Command="{Binding SendMapDataCommand}"
                                Style="{StaticResource PrimaryButton}" Width="200"/>

                        <TextBlock Text="{Binding ConnectionStatusText}"
                                   Foreground="{Binding ConnectionStatusBrush}"
                                   FontWeight="SemiBold"
                                   Margin="12,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Entity Count:" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding EntityCount}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,18,0"/>
                    <TextBlock Text="Route Count:" Style="{StaticResource LabelText}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding RouteCount}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                </StackPanel>
            </StackPanel>
        </Border>

        
        <!-- Configuration -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="Configuration" Style="{StaticResource SectionHeader}" FontSize="14"/>

                <!-- Mode -->
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Mode:" Style="{StaticResource LabelText}" Margin="0,0,12,0"/>
                    <RadioButton Content="Evaluation"
                     GroupName="Mode"
                     IsChecked="True"
                     Command="{Binding SetEvaluationModeCommand}"
                     Margin="0,0,16,0"
                     Style="{StaticResource DarkRadio}"/>

                    <RadioButton Content="Training"
                     GroupName="Mode"
                     Command="{Binding SetTrainingModeCommand}"
                                 Margin="0,0,16,0"
                     Style="{StaticResource DarkRadio}"/>

                    <RadioButton Content="Hybrid"
                     GroupName="Mode"
                     Command="{Binding SetHybridModeCommand}"
                     Style="{StaticResource DarkRadio}"/>
                </StackPanel>

                <!-- Mission -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Mission:" Style="{StaticResource LabelText}" Margin="0,0,12,0"/>
                    <RadioButton Content="Attack To Destroy"
                     GroupName="Mission"
                     IsChecked="True"
                     Command="{Binding SetATDModeCommand}"
                     Margin="0,0,16,0"
                     Style="{StaticResource DarkRadio}"/>

                    <RadioButton Content="Retain to Defeat"
                     GroupName="Mission"
                     Command="{Binding SetRTDModeCommand}"
                                 Margin="0,0,16,0"
                     Style="{StaticResource DarkRadio}"/>

                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Save to Folder -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2">
            <StackPanel>
                <TextBlock Text="Export (To Folder)" Style="{StaticResource SectionHeader}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,10">
                    <Button Content="Choose Folder…" Command="{Binding ChooseFolderCommand}"
              Style="{StaticResource GhostButton}" Width="140" Margin="0,0,8,0"/>
                    <Button Content="Save Map Data to Folder" Command="{Binding SaveToFolderCommand}"
              Style="{StaticResource PrimaryButton}" Width="200"/>
                </StackPanel>
                <TextBlock Text="{Binding OutputFolder}"
               Foreground="{StaticResource TextSecondary}"
               TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Logs -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Logs" Style="{StaticResource SectionHeader}"/>
                <Border Grid.Row="1" Background="#1B1B1B" CornerRadius="8" Padding="8" BorderThickness="0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding LogLines}" ItemTemplate="{StaticResource LogLineTemplate}"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- Assessment & Add to Map -->
        <Border Grid.Row="4" Style="{StaticResource CardStyle}" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Assessment" Style="{StaticResource SectionHeader}"/>

                <!-- ListBox allows us to select certain lines -->
                <ListBox x:Name="AssessmentList"
                         Grid.Row="1"
                         Background="#1B1B1B"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}"
                         ItemTemplate="{StaticResource LogLineTemplate}"
                         SelectionMode="Extended">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                        </Style>
                    </ListBox.Resources>
                    <ListBox.ItemsSource>
                        <Binding Path="AssessmentLines"/>
                    </ListBox.ItemsSource>
                </ListBox>

                <!-- Button: adds selected (or all if none selected) -->
                <!--
                                <Button Grid.Row="2"
                        Content="Add to Map"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right"
                        Width="120"
                        Command="{Binding AddAssessmentToMapCommand}"
                        CommandParameter="{Binding SelectedItems, ElementName=AssessmentList}" />
                -->
            </Grid>
        </Border>
    </Grid>
</UserControl>
